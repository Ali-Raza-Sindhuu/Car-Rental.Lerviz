# ==============================================================================
# Environment Configuration
# ==============================================================================
ENVIRONMENT=development
DEBUG=True

# --- PostgreSQL Settings ---
POSTGRES_USER=car_rental_user
POSTGRES_PASSWORD=car_rental_super_secret_password
POSTGRES_DB=car_rental_db
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://car_rental_user:car_rental_super_secret_password@postgres:5432/car_rental_db

# --- Redis Settings ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@redis:6379/0

# --- Frontend Settings ---
VITE_API_URL=http://localhost:8000

# --- Production Deployment Domain ---
DOMAIN_NAME=yourdomain.com