generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentType {
  RENTAL
  DEPOSIT
  LATE_FEE
  REFUND
}

enum PaymentMethod {
  CARD
  CASH
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MaintenanceType {
  SERVICE
  REPAIR
  INSPECTION
}

enum MaintenanceStatus {
  OPEN
  CLOSED
}

enum DiscountType {
  PERCENT
  FIXED
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  email          String           @unique @db.VarChar(254)
  passwordHash   String           @map("password_hash") @db.VarChar(255)
  fullName       String           @map("full_name") @db.VarChar(120)
  phone          String?          @db.VarChar(32)
  role           Role             @default(CUSTOMER)
  isActive       Boolean          @default(true) @map("is_active")
  deletedAt      DateTime?        @map("deleted_at")
  profile        CustomerProfile?
  refreshTokens  RefreshToken[]
  bookings       Booking[]
  reviews        Review[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("users")
}

model CustomerProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  dateOfBirth      DateTime @map("date_of_birth") @db.Date
  drivingLicenseNo String   @map("driving_license_no") @db.VarChar(80)
  licenseExpiry    DateTime @map("license_expiry") @db.Date
  address          String   @db.VarChar(255)
  city             String   @db.VarChar(100)
  country          String   @db.VarChar(100)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("customer_profiles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Location {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(120)
  city            String    @db.VarChar(100)
  address         String    @db.VarChar(255)
  phone           String    @db.VarChar(32)
  isActive        Boolean   @default(true) @map("is_active")
  vehicles        Vehicle[]
  pickupBookings  Booking[] @relation("PickupLocation")
  dropoffBookings Booking[] @relation("DropoffLocation")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("locations")
}

model VehicleCategory {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique @db.VarChar(80)
  description   String
  baseDailyRate Decimal   @map("base_daily_rate") @db.Decimal(12, 2)
  depositAmount Decimal   @map("deposit_amount") @db.Decimal(12, 2)
  vehicles      Vehicle[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("vehicle_categories")
}

model Vehicle {
  id              String           @id @default(uuid()) @db.Uuid
  categoryId      String           @map("category_id") @db.Uuid
  locationId      String           @map("location_id") @db.Uuid
  make            String           @db.VarChar(80)
  model           String           @db.VarChar(80)
  year            Int
  plateNo         String           @unique @map("plate_no") @db.VarChar(32)
  vin             String           @unique @db.VarChar(17)
  transmission    Transmission
  fuelType        FuelType         @map("fuel_type")
  seats           Int
  doors           Int
  color           String           @db.VarChar(50)
  mileageKm       Int              @map("mileage_km")
  dailyRate       Decimal          @map("daily_rate") @db.Decimal(12, 2)
  status          VehicleStatus    @default(AVAILABLE)
  deletedAt       DateTime?        @map("deleted_at")
  category        VehicleCategory  @relation(fields: [categoryId], references: [id])
  location        Location         @relation(fields: [locationId], references: [id])
  images          VehicleImage[]
  bookings        Booking[]
  reviews         Review[]
  maintenanceLogs MaintenanceLog[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([status, categoryId, locationId])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  url       String   @db.VarChar(512)
  isPrimary Boolean  @default(false) @map("is_primary")
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vehicleId])
  @@map("vehicle_images")
}

model Booking {
  id                 String      @id @default(uuid()) @db.Uuid
  bookingNo          String      @unique @map("booking_no") @db.VarChar(24)
  customerId         String      @map("customer_id") @db.Uuid
  vehicleId          String      @map("vehicle_id") @db.Uuid
  pickupLocationId   String      @map("pickup_location_id") @db.Uuid
  dropoffLocationId  String      @map("dropoff_location_id") @db.Uuid
  startAt            DateTime    @map("start_at")
  endAt              DateTime    @map("end_at")
  actualReturnAt     DateTime?   @map("actual_return_at")
  status             BookingStatus @default(PENDING)
  dailyRateSnapshot  Decimal     @map("daily_rate_snapshot") @db.Decimal(12, 2)
  totalDays          Int         @map("total_days")
  subtotal           Decimal     @db.Decimal(12, 2)
  discountAmount     Decimal     @map("discount_amount") @db.Decimal(12, 2)
  taxAmount          Decimal     @map("tax_amount") @db.Decimal(12, 2)
  lateFee            Decimal     @default(0) @map("late_fee") @db.Decimal(12, 2)
  depositAmount      Decimal     @map("deposit_amount") @db.Decimal(12, 2)
  totalAmount        Decimal     @map("total_amount") @db.Decimal(12, 2)
  couponId           String?     @map("coupon_id") @db.Uuid
  cancelReason       String?     @map("cancel_reason") @db.VarChar(500)
  notes              String?     @db.VarChar(1000)
  customer           User        @relation(fields: [customerId], references: [id])
  vehicle            Vehicle     @relation(fields: [vehicleId], references: [id])
  pickupLocation     Location    @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  dropoffLocation    Location    @relation("DropoffLocation", fields: [dropoffLocationId], references: [id])
  coupon             Coupon?     @relation(fields: [couponId], references: [id])
  payments           Payment[]
  review             Review?
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([vehicleId, startAt, endAt])
  @@index([customerId])
  @@map("bookings")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  bookingId      String        @map("booking_id") @db.Uuid
  type           PaymentType
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  transactionRef String?       @map("transaction_ref") @db.VarChar(100)
  paidAt         DateTime?     @map("paid_at")
  booking        Booking       @relation(fields: [bookingId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([bookingId])
  @@map("payments")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @unique @map("booking_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  rating     Int
  comment    String   @db.VarChar(2000)
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customer   User     @relation(fields: [customerId], references: [id])
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([vehicleId])
  @@map("reviews")
}

model MaintenanceLog {
  id          String            @id @default(uuid()) @db.Uuid
  vehicleId   String            @map("vehicle_id") @db.Uuid
  type        MaintenanceType
  description String            @db.VarChar(2000)
  cost        Decimal           @db.Decimal(12, 2)
  startDate   DateTime          @map("start_date")
  endDate     DateTime?         @map("end_date")
  status      MaintenanceStatus @default(OPEN)
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([vehicleId, startDate, endDate])
  @@map("maintenance_logs")
}

model Coupon {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique @db.VarChar(40)
  discountType DiscountType @map("discount_type")
  value        Decimal      @db.Decimal(12, 2)
  minDays      Int          @default(1) @map("min_days")
  validFrom    DateTime     @map("valid_from")
  validTo      DateTime     @map("valid_to")
  maxUses      Int          @map("max_uses")
  usedCount    Int          @default(0) @map("used_count")
  isActive     Boolean      @default(true) @map("is_active")
  bookings     Booking[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("coupons")
}

