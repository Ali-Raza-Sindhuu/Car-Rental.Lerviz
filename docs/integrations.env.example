# PROPOSED Node.js backend configuration. Current Python backend does not consume this file.
# Copy into the future application's ignored environment file, then add YOUR keys.
# Every external-provider key/secret intentionally starts blank.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
DB_HOST=shared-mysql
DB_PORT=3306
DB_NAME=lerviz
DB_USER=lerviz_app
DB_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379
SESSION_SECRET=

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional, only if using embedded Stripe Elements instead of hosted Checkout.
VITE_STRIPE_PUBLISHABLE_KEY=

EMAIL_PROVIDER=local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
RESEND_API_KEY=

MAPS_ENABLED=false
VITE_GOOGLE_MAPS_API_KEY=

SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

OBSERVABILITY_ENABLED=false
SENTRY_DSN=
# Browser-public values only. Never prefix backend secrets with VITE_.
VITE_API_URL=/api/v1
